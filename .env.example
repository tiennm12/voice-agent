OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PORT=3000

# Required. The one password for the dashboard, the test-call page and the bridge page.
# Use a long random one: it is all that stands between the internet and the recordings.
DASHBOARD_PASSWORD=

# Who the agent answers for; used in the greeting and the system prompt.
OWNER_NAME=anh Tuấn

# Optional: where the missed-call summary is sent. Without these the call is only saved to disk.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning (seconds): hang up after this much silence / at this call length.
SILENCE_TIMEOUT_SECONDS=10
MAX_CALL_SECONDS=180

# Optional: calls older than this many days are deleted, recording included (default 30).
RETENTION_DAYS=30

# Optional: the offset every stored time uses, whatever zone the server's clock is in (default 7).
UTC_OFFSET_HOURS=7

# Optional: where the database and recordings go (default: ./data).
# DATA_DIR=/var/lib/voice-agent
