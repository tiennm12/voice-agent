OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PORT=3000

# Required. The one password for the dashboard, the test-call page and the bridge page.
# Use a long random one: it is all that stands between the internet and the recordings.
DASHBOARD_PASSWORD=

# Who the agent answers for; used in the greeting and the system prompt.
OWNER_NAME=anh Tuấn

# Optional: where the missed-call summary is sent. Without these the call only shows in the dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: this server's public https address. Adds a "listen" button under each Telegram
# message, opening that one call without logging in (the link is valid for 7 days).
PUBLIC_BASE_URL=
# Optional: an urgent call is repeated on Telegram this often (3 times at most) until it is read.
URGENT_REMINDER_MINUTES=5

# Optional tuning (seconds): hang up after this much silence / at this call length.
SILENCE_TIMEOUT_SECONDS=10
MAX_CALL_SECONDS=180

# Optional latency knobs, all off by default. See "Response time" in the README for what each bought.
# Milliseconds of silence that end the caller's turn (OpenAI default 500). Lower answers sooner, cuts in on pauses.
# VAD_SILENCE_MS=300
# How loud counts as speech, 0-1 (OpenAI default 0.5). Raise it if line echo keeps interrupting the agent.
# VAD_THRESHOLD=0.6
# Have ElevenLabs speak each clause as it arrives instead of buffering 120 characters first.
# ELEVENLABS_AUTO_MODE=1
# The model that talks to the caller (default gpt-6-luna). Keep config/pricing.json in step with it.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# Reasoning models think for seconds before the first word unless told not to. The default
# model already runs with "none". Set this only for another reasoning model; models without
# reasoning (gpt-4.1-mini, gpt-4o-mini) reject the parameter.
# OPENAI_REASONING_EFFORT=none

# Optional: calls older than this many days are deleted, recording included (default 30).
RETENTION_DAYS=30

# Optional: the offset every stored time uses, whatever zone the server's clock is in (default 7).
UTC_OFFSET_HOURS=7

# Optional: where the database and recordings go (default: ./data).
# DATA_DIR=/var/lib/voice-agent
