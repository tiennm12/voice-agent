OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PORT=3000

# Required. The one password for the dashboard, the test-call page and the bridge page.
# Use a long random one: it is all that stands between the internet and the recordings.
DASHBOARD_PASSWORD=

# Who the agent answers for; used in the greeting and the system prompt.
OWNER_NAME=anh Tuấn

# Optional: where the missed-call summary is sent. Without these the call only shows in the dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: this server's public https address. Adds a "listen" button under each Telegram
# message, opening that one call without logging in (the link is valid for 7 days).
PUBLIC_BASE_URL=
# Optional: an urgent call is repeated on Telegram this often (3 times at most) until it is read.
URGENT_REMINDER_MINUTES=5

# Optional tuning (seconds): hang up after this much silence / at this call length. 15 s before the
# length is reached the agent says goodbye and hangs up itself (every pipeline but live).
SILENCE_TIMEOUT_SECONDS=10
MAX_CALL_SECONDS=180

# Optional latency knobs, all off by default. See "Response time" in the README for what each bought.
# Milliseconds of silence that end the caller's turn (OpenAI default 500). Lower answers sooner, cuts in on pauses.
# VAD_SILENCE_MS=300
# How loud counts as speech, 0-1 (OpenAI default 0.5). Raise it if line echo keeps interrupting the agent.
# VAD_THRESHOLD=0.6
# Drop transcripts the model is less sure of than this (mean token log-probability). Off by default:
# on a bad line real speech and noise both score -1 to -2.5, so any cut-off loses real words. The
# server logs each score as "[stt] confidence=" to judge it by.
# STT_MIN_LOGPROB=-1.5
# Speech-to-text service: openai (default) or elevenlabs (Scribe v2 Realtime; the API key needs the
# speech_to_text permission). /call.html can pick one per call to compare them.
# STT_PROVIDER=elevenlabs
# Have ElevenLabs speak each clause as it arrives instead of buffering 120 characters first.
# ELEVENLABS_AUTO_MODE=1
# The model that talks to the caller (default gpt-6-luna). Keep config/pricing.json in step with it.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# Reasoning models think for seconds before the first word unless told not to. The default
# model already runs with "none". Set this only for another reasoning model; models without
# reasoning (gpt-4.1-mini, gpt-4o-mini) reject the parameter.
# OPENAI_REASONING_EFFORT=none

# Optional: how a call is handled (default classic). classic = transcription -> chat model ->
# ElevenLabs; hybrid = a Realtime model hears the caller and answers in text, ElevenLabs speaks it
# (~1.5 s instead of ~2.7 s); realtime = one speech-to-speech session with OpenAI voices (~1.3 s).
# call.html can pick one per call. See "Realtime and hybrid pipelines" in the README.
# PIPELINE=hybrid
# The Realtime model of hybrid and realtime (default gpt-realtime-2.1); its rates go in config/pricing.json.
# OPENAI_AGENT_MODEL=gpt-realtime-2.1-mini
# PIPELINE=live: a GPT-Live session that listens while it speaks; its voice (default marin, see call.html).
# OPENAI_LIVE_VOICE=marin

# Optional: speech-to-text for classic (default openai; also elevenlabs, soniox). Soniox ends a
# turn from the words and intonation, not silence alone; it needs its own key.
# STT_PROVIDER=soniox
# SONIOX_API_KEY=

# Optional: calls older than this many days are deleted, recording included (default 30).
RETENTION_DAYS=30

# Optional: the offset every stored time uses, whatever zone the server's clock is in (default 7).
UTC_OFFSET_HOURS=7

# Optional: the address to listen on (default: all interfaces). Set 127.0.0.1 behind a reverse proxy.
# HOST=127.0.0.1
# Optional: where the database and recordings go (default: ./data).
# DATA_DIR=/var/lib/voice-agent
